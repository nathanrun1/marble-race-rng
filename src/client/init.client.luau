-- ShopUI before UpgradeLocks/UpgradeShop: they render pad billboards from its local caches.
ShopUI.Init()
UpgradeLocks.Init() -- before UpgradeShop: its lock state greys/hides gated kiosks
UpgradeShop.Init()
BallEffects.Init()
ScoreUI.Init()
AnnounceUI.Init()
WarnUI.Init()
SoundService.Init()
ProductService.Init()
BallTuningUI.Init()
BallLaunchUI.Init()
PrestigeUI.Init()
AutoScale.Init()
CameraController.Init()
CameraZone.Init()
MiscUI.Init()
LauncherView.Init()
BallTuningPreview.Init()
JackpotGateUI.Init()
GroupRewardUI.Init()
TutorialController.Init()
CurrencyFlyUI.Init() -- before its consumers (CoinPickups/QuestUI/PlaytimeUI/DailyRewardUI) can claim
CoinPickups.Init()
PlaytimeUI.Init()
MoneyPerBallUI.Init()
DiamondsShopUI.Init() -- before CosmeticsShop (which opens it on can't-afford rolls)
